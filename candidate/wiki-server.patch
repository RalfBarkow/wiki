+export const isLoopbackHost = host => {
+  const value = String(host || '').trim().toLowerCase()
+  if (!value) return false
+  let normalizedHost = value
+  try {
+    normalizedHost = new URL(value.includes('://') ? value : `http://${value}`).hostname.toLowerCase()
+  } catch {
+    normalizedHost = value
+  }
+  return (
+    normalizedHost === 'localhost' ||
+    normalizedHost === '127.0.0.1' ||
+    normalizedHost === '::1' ||
+    normalizedHost.endsWith('.localhost')
+  )
+}
+
+export const buildRemoteRequestURLs = (wikiName, remoteHost, remoteResource) => {
+  const blocked = !isLoopbackHost(wikiName) && isLoopbackHost(remoteHost)
+  return {
+    blocked,
+    candidates: blocked ? [] : [`https://${remoteHost}/${remoteResource}`, `http://${remoteHost}/${remoteResource}`],
+  }
+}
+
+const fetchWithProtocolFallback = async (requestURLs, { timeoutMs = 2000, headers } = {}) => {
+  let lastError
+  for (const requestURL of requestURLs) {
+    try {
+      const response = await fetch(requestURL, {
+        signal: AbortSignal.timeout(timeoutMs),
+        headers,
+      })
+      return { requestURL, response }
+    } catch (error) {
+      lastError = error
+    }
+  }
+  throw lastError
+}
+
+const proxyResponseHeaderAllowlist = new Set(['content-type', 'cache-control', 'etag', 'last-modified'])
+
